rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function active() { return signedIn() && me().data.status == 'active'; }
    function role(name) { return active() && me().data.role == name; }
    function admin() { return role('admin') && request.auth.token.admin == true; }
    function owns(id) { return signedIn() && request.auth.uid == id; }
    function unchanged(fields) { return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields); }
    function institutionalEmail() {
      return request.auth.token.email.matches('.*@(my\\.richfield\\.ac\\.za|richfield\\.ac\\.za|my\\.aaa\\.ac\\.za|aaa\\.ac\\.za)$');
    }

    match /users/{userId} {
      allow create: if owns(userId)
        && request.resource.data.role in ['student', 'alumni', 'business']
        && request.resource.data.status == 'pending'
        && request.resource.data.email == request.auth.token.email
        && (request.resource.data.role != 'student' || institutionalEmail());
      allow read: if owns(userId) || active() && (
        admin() ||
        resource.data.visibility.public.size() > 0 ||
        resource.data.visibility.business.size() > 0 && role('business')
      );
      allow update: if admin() || (owns(userId) && (
        unchanged(['role', 'status', 'verified', 'email']) ||
        resource.data.role == 'student' && resource.data.status == 'pending'
          && request.resource.data.status == 'active' && request.resource.data.verified == true
          && request.auth.token.email_verified == true && institutionalEmail()
      ));
      allow delete: if admin();
      match /notifications/{notificationId} {
        allow read, update: if owns(userId);
        allow create: if active();
      }
    }

    match /posts/{postId} {
      allow read: if active() && (request.auth.uid in resource.data.visibleTo || admin());
      allow create: if active() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if admin() || (active() && resource.data.authorId == request.auth.uid);
      match /comments/{commentId} {
        allow read: if active();
        allow create: if active() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if admin() || (active() && resource.data.authorId == request.auth.uid);
      }
      match /reactions/{userId} {
        allow read: if active();
        allow create, update, delete: if active() && owns(userId);
      }
    }

    match /connections/{connectionId} {
      allow read: if active() && request.auth.uid in resource.data.participants;
      allow create: if active() && request.auth.uid == request.resource.data.requestedBy;
      allow update: if active() && request.auth.uid in resource.data.participants;
      allow delete: if active() && request.auth.uid in resource.data.participants || admin();
    }

    match /opportunities/{opportunityId} {
      allow read: if active() && (resource.data.status == 'approved' || admin() || resource.data.businessId == request.auth.uid);
      allow create: if role('business') && request.resource.data.businessId == request.auth.uid && request.resource.data.status == 'pending';
      allow update, delete: if admin() || (role('business') && resource.data.businessId == request.auth.uid && unchanged(['status', 'approvedBy', 'publishedAt']));
      match /applications/{userId} {
        allow create, read, update: if owns(userId) || admin() || (role('business') && get(/databases/$(database)/documents/opportunities/$(opportunityId)).data.businessId == request.auth.uid);
      }
    }

    match /conversations/{conversationId} {
      allow read, update: if active() && request.auth.uid in resource.data.participants;
      allow create: if active() && request.auth.uid in request.resource.data.participants;
      match /messages/{messageId} {
        allow read: if active() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if active() && request.resource.data.senderId == request.auth.uid && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }
    }

    match /events/{eventId} {
      allow read: if active() && resource.data.status == 'published';
      allow write: if admin();
    }

    match /announcements/{announcementId} {
      allow read: if active() && (resource.data.audience == 'all' || me().data.role in resource.data.audience);
      allow write: if admin();
    }

    match /analytics/{document=**} { allow read: if admin(); }
  }
}
